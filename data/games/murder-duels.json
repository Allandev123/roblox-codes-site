  "faq": [
    {
      "q": "Why do Murder Duels codes not work for me?",
      "a": "You need to be in the Breakfast Roblox group and be level 5 or higher. If both are true, check that the code is in capital letters with no spaces."
    },
    {
      "q": "When does the next Murder Duels code come out?",
      "a": "New codes are tied to like goals, usually one for every 10,000 extra likes. Liking the game helps it reach the next goal sooner, and the code is shared in the Discord when it does."
    },
    {
      "q": "Why did 220KLIKES stop working in Murder Duels?",
      "a": "Older like-milestone codes are usually switched off after a newer one comes out. Use 230KLIKES instead, along with the other active codes."
    }
  ],
