  "faq": [
    {
      "q": "Where do I redeem codes in Elemental Magic Arena?",
      "a": "There is no code button on the screen. Walk into the green codes circle on the lobby floor, next to the Magic Forge anvil, and a text box will pop up."
    },
    {
      "q": "Why is 120KLIKES not working?",
      "a": "Older like-goal codes like 120KLIKES and 110KLIKES have expired. Usually only the newest few like codes stay active."
    },
    {
      "q": "When does the next Elemental Magic Arena code come out?",
      "a": "New codes usually match like-goals, so watch the like count on the game page. When it passes the next 10,000 mark, a new KLIKES code often follows."
    }
  ],
