  "faq": [
    {
      "q": "Why does brazil44 not work anymore in Restaurant Tycoon 3?",
      "a": "Boost codes only last a short time before a new one replaces them. brazil44, fall2026 and alora have all expired, so try Wavey or Visionary instead."
    },
    {
      "q": "What do the creator codes give?",
      "a": "Each creator code unlocks three decorations with that YouTuber's name on them: a trophy, a poster and a statue. They are for decorating and do not raise your earnings."
    },
    {
      "q": "Is the code 01 real?",
      "a": "Yes. It is the creator code for janisjanis01 and gives that creator's trophy, poster and statue. Type just the two digits, zero then one."
    }
  ],
