  "faq": [
    {
      "q": "Why does a Lineage Piece code not work for me?",
      "a": "Every code has a level requirement, from level 100 up to level 1750. If your level is too low, the code will not redeem until you level up."
    },
    {
      "q": "Do I need to join the group to use Lineage Piece codes?",
      "a": "Yes. Join the Prlz's Den group and like the game, then rejoin a server before trying the codes."
    },
    {
      "q": "Where is the code box in Lineage Piece?",
      "a": "Open Settings from the icon on the left side of the screen and scroll to the bottom. Type the code there and press Enter."
    }
  ],
