  "faq": [
    {
      "q": "Why does SKGames say invalid in King Legacy?",
      "a": "That code only works if you are in the Sea King Games Roblox group. Join the group, rejoin the game and try again."
    },
    {
      "q": "Should I use FREESTATSRESET now or save it?",
      "a": "Save it until you switch to a new fruit or weapon. A stat reset is most useful when your build changes, not at the start."
    },
    {
      "q": "Who can use RainbowDragon and DragonColorRefund?",
      "a": "Both are for players who owned the Dragon fruit before Update 7. RainbowDragon needs the rainbow dragon unlocked, and DragonColorRefund gives 50 Gems, or 10 if your dragon was red."
    }
  ],
