  "faq": [
    {
      "q": "Why did Update1 stop working in Pets Universe?",
      "a": "Update codes get replaced as new updates come out. Update1 expired after Update2 arrived, so always use the newest update code."
    },
    {
      "q": "Where is the code box in Pets Universe?",
      "a": "It is at the very bottom of the Exclusive Shop, which opens from the shopping basket icon on the left of the screen."
    },
    {
      "q": "When should I use a Luck Potion in Pets Universe?",
      "a": "Drink it right before you open a big batch of eggs, ideally the best egg you can afford, so none of the boost is wasted."
    }
  ],
