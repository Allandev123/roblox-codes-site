  "faq": [
    {
      "q": "Why did Update1 stop working in Pets Universe?",
      "a": "Update codes get replaced as new updates come out. Update1 expired after Update2 arrived, so always use the newest update code."
    },
    {
      "q": "Where is the code box in Pets Universe?",
      "a": "It is at the very bottom of the Exclusive Shop, which opens from the shopping basket icon on the left of the screen."
    },
    {
      "q": "When should I use a Luck Potion in Pets Universe?",
      "a": "Drink it right before you open a big batch of eggs, ideally the best egg you can afford, so none of the boost is wasted."
    }
  ],
  "tips": [
    "Pick up coins as you walk around, then hatch the best egg you can afford. Stronger pets collect coins faster, which gets you to the next egg sooner.",
    "After each batch of eggs, check your equipped pets and swap in any stronger ones you just hatched.",
    "Join the group and follow the game. The description says this gives bonus rewards, which is an easy win when you are starting out.",
    "The game gets new updates every week, so new pets keep arriving. Check back after each update to see what has been added."
  ],
  "useRewards": "Redeem Update2 first, because update codes expire when the next update comes out. Save Coins, Rubies and Critical Potions for a long farming session so the extra income adds up. Keep Hatch Potions and Luck Potions for your best egg. The fruit and the Lucky Blocks from 1MVisits are small extras, so use them whenever you like. The creator codes have lasted longer, but claim them anyway.",
  "codeChannels": "The Lip Builds Discord server and the Pets Universe wiki codes page"
}
