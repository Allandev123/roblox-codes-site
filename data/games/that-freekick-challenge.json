  "faq": [
    {
      "q": "Why can't I find the code box in That Freekick Challenge?",
      "a": "It sits at the very bottom of Settings, which you open from the Misc. button in the top-left. It only works once you have finished the tutorial."
    },
    {
      "q": "Should I spend code coins or Perk Points first?",
      "a": "Put coins into cards for the stat you miss most, usually Accuracy or Curl. Save Perk Points for a skill that helps with the shots you struggle on."
    },
    {
      "q": "Does KNUCKL3 still work?",
      "a": "It was only for a limited number of players, so it may already be used up. If it says invalid, the other codes on this list still work."
    }
  ],
