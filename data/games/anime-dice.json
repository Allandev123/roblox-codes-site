  "faq": [
    {
      "q": "Why can't I find the code box in Anime Dice?",
      "a": "The code box sits at the very bottom of the Shop, which opens from the left side of the screen. It only works once you have finished the tutorial."
    },
    {
      "q": "Why does JPCALLING not work for me?",
      "a": "JPCALLING was limited to the first 750 players, so it may already be used up even though other codes still work."
    },
    {
      "q": "Should I spend Trait Rerolls right away?",
      "a": "Save them for a rare character you plan to keep on your team. A good trait on a strong character adds far more to your earnings than one on a starter you will replace soon."
    }
  ],
  "codeChannels": "The official Anime Dice Discord server and the More & More Games Roblox group",
  "requirement": "Finish the tutorial before you try to redeem codes."
}
