  "faq": [
    {
      "q": "Why won't Fish It! let me type in a code?",
      "a": "The code box only unlocks once you reach level 10. Keep fishing at the starting island for a bit and it will open up."
    },
    {
      "q": "Should I use a Luck II or a Mutation II potion first?",
      "a": "Use Luck II when you want rarer fish, such as secret catches at a new island. Use Mutation II when you are fishing somewhere you already know well, since mutated fish sell for more coins."
    },
    {
      "q": "Did the Arcadia update come with a new code?",
      "a": "No new code was reported with the Arcadia island. The newest code going around is ELEMENTAL26, which gives two Mutation II potions."
    }
  ],
